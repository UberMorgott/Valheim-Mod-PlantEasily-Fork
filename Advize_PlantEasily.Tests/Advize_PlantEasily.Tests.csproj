<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 on Microsoft Testing Platform (root global.json selects MTP), same layer as tools\valbuild tests.
         The plugin csproj stays the upstream old-style net48 project; only pure rules are compiled in here. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Advize_PlantEasily.Tests</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <Compile Include="..\Advize_PlantEasily\Core\SnapSystem\GhostRefresh.cs" Link="GhostRefresh.cs" />
    <Compile Include="..\Advize_PlantEasily\Core\SnapSystem\PressCost.cs" Link="PressCost.cs" />
    <Compile Include="..\Advize_PlantEasily\Core\ModEnums.cs" Link="ModEnums.cs" />
  </ItemGroup>

</Project>
